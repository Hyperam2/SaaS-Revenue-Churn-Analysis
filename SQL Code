-- ^^^^^^^^^^^^^^^
-- Company_Insight
-- ^^^^^^^^^^^^^^^

WITH CLV_per_Plan AS
(
    SELECT
        plan,
        ROUND(AVG(monthly_revenue), 2) AS Avg_Mrr,
        AVG(TIMESTAMPDIFF(MONTH, signup_date, churn_date)) AS Avg_lifespan,
        ROUND(
            AVG(monthly_revenue) *
            AVG(TIMESTAMPDIFF(MONTH, signup_date, churn_date)),
            2
        ) AS CLV
    FROM subscriptions
    GROUP BY plan
),
AVG_CAC AS
(
    SELECT
        ROUND(AVG(customer_acquisition_cost), 2) AS avg_CAC
    FROM monthly_revenue
)

SELECT
    c.plan,
    c.Avg_Mrr,
    ROUND(c.Avg_lifespan, 2) AS Avg_lifespan,
    c.CLV,
    a.avg_CAC,
    ROUND(c.CLV / NULLIF(a.avg_CAC, 0), 2) AS CLV_CAC_Ratio
FROM CLV_per_plan AS c
CROSS JOIN AVG_CAC AS a
ORDER BY CLV_CAC_Ratio DESC;



-- ^^^^^^^^^^^^^^^^^^^^^^^
-- Top 3 Reasons For Churn
-- ^^^^^^^^^^^^^^^^^^^^^^^

Select churn_reason
From subscriptions
Group by churn_reason 
 Having churn_reason Is not null
 Order by Count(customer_id) DESC
 Limit 3 ;
