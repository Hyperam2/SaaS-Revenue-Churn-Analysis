-- ^^^^^^^^^^^^^^^
-- Total Customers
-- ^^^^^^^^^^^^^^^

Select COUNT(customer_id) AS Total_Customers 
From subscriptions;

-- ^^^^^^^^^^^^^^^^^^^^^^
-- Active Customers Check
-- ^^^^^^^^^^^^^^^^^^^^^^

Select SUM(Case When churned = 'No' THEN 1 ELSE 0 END) as Active_customers
From subscriptions;

-- ^^^^^^^^^^^^^^^^^^^^^^^^^
-- Overall Churned Customers
-- ^^^^^^^^^^^^^^^^^^^^^^^^^


Select SUM(Case When churned = 'Yes' THEN 1 ELSE 0 END) as Churned_Customers
From subscriptions;


-- ^^^^^^^^^^^^^^^^^^^
-- Overall Churn Rate 
-- ^^^^^^^^^^^^^^^^^^^


WITH Churn_Rate AS
(
    SELECT
        COUNT(customer_id) AS Total_Customers,
        SUM(CASE WHEN churned = 'Yes' THEN 1 ELSE 0 END)
            AS Churned_Customers
    FROM subscriptions
)

SELECT
    ROUND(
        100.0 * Churned_Customers /
        NULLIF(Total_Customers, 0),
        1
    ) AS Rate_Of_Churn
FROM Churn_Rate;



-- ^^^^^^^^^^^^^^^^^^^^
-- Churn_Rate_Per_Plan 
-- ^^^^^^^^^^^^^^^^^^^^

WITH Churn_Rate_Per_Plan AS
(
    SELECT
        plan,
        COUNT(customer_id) AS Customers_by_Plan,
        SUM(CASE WHEN churned = 'Yes' THEN 1 ELSE 0 END)
            AS Churned_Customers
    FROM subscriptions
    GROUP BY plan
)

SELECT
    plan,
    Customers_by_Plan,
    Churned_Customers,
    ROUND(
        100.0 * Churned_Customers /
        NULLIF(Customers_by_Plan, 0),
        1
    ) AS Churn_Rate
FROM Churn_Rate_Per_Plan;


-- ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
-- Churn_Rate_Per_Billing_Cycle
-- ^^^^^^^^^^^^^^^^^^^^^^^^^^^^

WITH Churn_Per_Billing_Cycle AS
(
    SELECT
        billing_cycle,
        COUNT(customer_id) AS Total_Customers_Per_Billing_Cycle,
        SUM(CASE WHEN churned = 'Yes' THEN 1 ELSE 0 END)
            AS Churned_Customers
    FROM subscriptions
    GROUP BY billing_cycle
)

SELECT
    billing_cycle,
    Total_Customers_Per_Billing_Cycle,
    Churned_Customers,
    ROUND(
        100.0 * Churned_Customers /
        NULLIF(Total_Customers_Per_Billing_Cycle, 0),
        2
    ) AS churn_rate_per_billing_cycle 
FROM Churn_Per_Billing_Cycle;

-- ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
-- Churn_Rate_by_Acquisition_Channel 
-- ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


WITH Churn_by_Acquisition_Channel AS
(
    SELECT
        acquisition_channel,
        COUNT(customer_id) AS Total_Customers_per_Acquisition_Channel,
        SUM(CASE WHEN churned = 'Yes' THEN 1 ELSE 0 END) AS Churned_Customers
    FROM subscriptions
    GROUP BY acquisition_channel
)

SELECT
    acquisition_channel,
    Total_Customers_per_Acquisition_Channel,
    Churned_Customers,
    ROUND(
        100.0 * Churned_Customers /
        NULLIF(Total_Customers_per_Acquisition_Channel, 0),
        2
    ) AS Churn_Rate_per_Acquisition_Channel
FROM Churn_by_Acquisition_Channel
ORDER BY Churn_Rate_per_Acquisition_Channel DESC;


